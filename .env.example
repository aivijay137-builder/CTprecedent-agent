LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

LLM_MODEL_ALT=
LLM_RPM=20
LLM_PRICE_IN=
LLM_PRICE_OUT=
LLM_PRICE_IN_ALT=
LLM_PRICE_OUT_ALT=
LLM_WORKERS=4

# true = canned demo data (Phase A); false = real registry data
FIXTURES=false
CTG_DB_PATH=

# --- Phase C (AI reading) ---
LLM_ENABLED=off            # master switch: on = the app makes paid AI calls
LLM_MAX_CALLS_PER_RUN=60   # hard cap per precedent check
LLM_DAILY_BUDGET_USD=0.50  # hard cap per day (UTC)
LLM_TIMEOUT_S=60  # one AI call is given up after this many seconds (the app then uses the free reader)
# Fallback order when a call fails: LLM_MODEL, LLM_MODEL_ALT, LLM_MODEL_ALT3, LLM_MODEL_ALT2 (weakest, last).
# A fallback with no price of its own is billed at the main model price (an estimate that errs high). Optional: LLM_PRICE_IN_ALT, LLM_PRICE_OUT_ALT (also _ALT2, _ALT3).
LLM_TIME_BUDGET_S=40       # a run stops starting new AI calls after this many seconds
LLM_PRICE_IN_ALT3=         # USD per million tokens for LLM_MODEL_ALT3; blank = uses the main model's price as an estimate
LLM_PRICE_OUT_ALT3=
CUTOFF_FLAGS=off           # on = cutoff-based flags may fire (turn on only after the 50-trial hand-check)

# --- Step 1a: data sync ---
SYNC_SECRET=               # long random string; the cron service sends it in the X-Sync-Secret header to POST /admin/sync
DATA_DIR=                  # folder holding serving.duckdb (Railway: /data). Blank = ./data
SERVING_DB=                # optional full path override
SYNC_PAUSE_S=0.5           # pause between API pages
